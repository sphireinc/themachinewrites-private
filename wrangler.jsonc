{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "themachinewrites-private",
  "compatibility_date": "2025-07-18",
  "pages_build_output_dir": "dist",
  "vars": {
    "PUBLIC_CONTENT_OWNER": "sphireinc",
    "PUBLIC_CONTENT_REPO": "themachinewrites-public",
    "PUBLIC_CONTENT_BRANCH": "main",
    "PUBLIC_CONTENT_ORIGIN": "https://raw.githubusercontent.com",
    "FEED_CACHE_SECONDS": "60"
  },
  "env": {
    "preview": {
      "vars": {
        "PUBLIC_CONTENT_OWNER": "sphireinc",
        "PUBLIC_CONTENT_REPO": "themachinewrites-public",
        "PUBLIC_CONTENT_BRANCH": "main",
        "PUBLIC_CONTENT_ORIGIN": "https://raw.githubusercontent.com",
        "FEED_CACHE_SECONDS": "60"
      }
    }
  }
}
